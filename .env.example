# Plain value the admin sends as `admin_secret_key` when issuing a token.
ADMIN_SECRET_KEY=the-admin-secret-key-change-it

# Key used to sign the JWTs. Rotating it revokes every issued token at once.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
TOKEN_SIGNING_SECRET=replace-with-a-long-random-value

# Number of uvicorn workers for the hosted MCP app.
WEB_WORKERS=2

# Build the index on the first container start (0 afterwards).
REINDEX_ON_START=0

# OCR of base64 images while reindexing (indexer image includes the ocr extra).
REINDEX_OCR=1

# Optional overrides.
# PUBLIC_LAWS_BASE_URL=https://mcp.chatcodfiscal.ro/laws
# MCP_ALLOWED_HOSTS=mcp.chatcodfiscal.ro,mcp.chatcodfiscal.ro:*,localhost,localhost:*
# MCP_DISABLE_DNS_REBINDING=0
