# Plain value the admin sends as `admin_secret_key` when issuing a token.
ADMIN_SECRET_KEY=the-admin-secret-key-change-it

# Key used to sign the JWTs. Rotating it revokes every issued token at once.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
TOKEN_SIGNING_SECRET=replace-with-a-long-random-value

# Number of uvicorn workers for the MCP app.
WEB_WORKERS=2

# With 1, the legislatie-indexer service rebuilds the index once when
# `make start` launches it. Defaults to 0 (disabled).
REINDEX_ON_START=0

# OCR of base64 images while reindexing (always available in the image).
REINDEX_OCR=1

# Prefix for every link returned by the MCP tools. For local use keep the
# FastAPI default below; when you put Caddy (or any static server for
# 3-expanded/ and 5-pdfs/) in front, change it to e.g.
# PUBLIC_LAWS_BASE_URL=https://your-host/laws
PUBLIC_LAWS_BASE_URL=http://localhost:8000/laws

# MCP DNS-rebinding allowlist. Extend with your Caddy host when you add one.
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*
MCP_ALLOWED_ORIGINS=http://localhost:8000
MCP_DISABLE_DNS_REBINDING=0
